{
  "name": "chat-agents-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:types && tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "npm run generate:types && tsc --noEmit",
    "check:model-options": "node scripts/check-model-options-regression.mjs",
    "check:layout": "npm run build && node scripts/check-layout-regression.mjs && node scripts/check-message-scroll-regression.mjs",
    "test:title-generation": "node --import ./node_modules/tsx/dist/loader.mjs --test scripts/check-title-generation-interactions.mjs scripts/check-title-proxy-disconnect.mjs",
    "generate:types": "node scripts/generate-api-types.mjs"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.58",
    "@tanstack/react-query": "5.90.2",
    "eventsource-parser": "3.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.8.2",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@tailwindcss/vite": "4.1.13",
    "@types/node": "24.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.1.3"
  }
}
