# ==================== API 密钥 ====================
# Anthropic Claude API 密钥
ANTHROPIC_API_KEY=填你claude API

# Tavily API 密钥（用于 Web 搜索）
TAVILY_API_KEY=填你tavily API

# Jina Reader API 密钥（可选，用于 web_reader；不填也能用，只是配额更低）
JINA_API_KEY=

# OpenAI API 密钥（可选，如果使用 OpenAI 模型）
OPENAI_API_KEY=sk-your-key-here

# Groq API 密钥（可选，如果使用 Groq 模型）
GROQ_API_KEY=gsk_your-key-here

# ==================== 前后端连接（Docker 内部已配置，无需修改） ====================
# compose.yaml 已设置后端服务地址为 http://backend:8080
# 本地开发（非 Docker）时使用：
# VITE_BACKEND_ORIGIN=http://localhost:8080
