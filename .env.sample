# ==================== API 密钥 ====================
# Anthropic Claude API 密钥
ANTHROPIC_API_KEY=填你claude API

# Tavily API 密钥（用于 Web 搜索）
TAVILY_API_KEY=填你tavily API

# Jina Reader API 密钥（可选，用于 web_reader；不填也能用，只是配额更低）
JINA_API_KEY=

# OpenAI API 密钥（可选，如果使用 OpenAI 模型）
OPENAI_API_KEY=sk-your-key-here

# Groq API 密钥（可选，如果使用 Groq 模型）
GROQ_API_KEY=gsk_your-key-here

# ==================== PostgreSQL（本地开发默认值） ====================
POSTGRES_DB=chat_agents
POSTGRES_USER=root
POSTGRES_PASSWORD=Agent@Dev_1
# DATABASE_URL 中的 @ 必须编码为 %40
POSTGRES_PASSWORD_URLENCODED=Agent%40Dev_1

# ==================== 前后端连接 ====================
# 后端固定监听 8080：Dockerfile 的 EXPOSE/--port、compose 映射的容器侧、
# 前端 dev 代理默认值都是它，改一处就要四处一起改。
# 本地直起走 `scripts/dev.py serve`，端口已经钉好，通常不需要设下面这行。
# 只有把后端跑在别处（例如 compose 的宿主映射 19180）时才需要覆盖：
# VITE_BACKEND_ORIGIN=http://127.0.0.1:19180
