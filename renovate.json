{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "prPriority": 10
  },
  "packageRules": [
    {
      "description": "Group routine minor and patch updates weekly",
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["before 5am on monday"],
      "groupName": "weekly non-major updates",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major updates always require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Prioritize vulnerability updates and require manual review except patch updates",
      "matchVulnerabilityAlerts": true,
      "groupName": "security updates",
      "automerge": false,
      "prPriority": 10
    },
    {
      "description": "Automatically merge patch vulnerability fixes",
      "matchVulnerabilityAlerts": true,
      "matchUpdateTypes": ["patch"],
      "groupName": "security updates",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep AG-UI contract dependencies pinned and synchronized",
      "matchPackageNames": ["@ag-ui/core", "eventsource-parser", "zod"],
      "rangeStrategy": "pin",
      "groupName": "AG-UI contract dependencies",
      "labels": ["ag-ui"],
      "automerge": false
    }
  ]
}
